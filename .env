# ── AI ──────────────────────────────────────────────────────────────────────
# Required. AI features do not work without a model key.
# Preferred: a Claude key (https://console.anthropic.com/). A value in the
# shell wins over this file.
CLAUDE_API_KEY=
#
# No Claude key? Uncomment and set these, then recreate KGS.
# See docs/OPENAI.md. Other models can give different or unsatisfactory results.
# LLM_API=openai
# OPENAI_API_KEY=
# OPENAI_API_URL=https://api.together.xyz/v1
# OPENAI_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct-Turbo

# ── Postgres ────────────────────────────────────────────────────────────────
POSTGRES_USER=khoji-admin
POSTGRES_PASSWORD=khoji
POSTGRES_DB=khoji-admin

# ── Celery ─────────────────────────────────────────────────────────────────
CELERY_WORKER_CONCURRENCY=4

# ── Jira OAuth connector (KBS backend + Angular BFF) ────────────────────────
# OAuth 2.0 (3LO) consumer registered in the Atlassian developer console.
JIRA_CLIENT_ID=OObevlSfWpZbEl73iTHIyxFIRon0dScj
JIRA_CLIENT_SECRET=ATOA9bVeIPWSnw4WCFPBue87icr3tZLCWitVE9-CxLrNlCe1ob3uCAy2Wpm8PQ2Y5vYF70EBB1F6
JIRA_CLIENT_REDIRECT_URI=http://localhost:4241/login

# ── Email (outbound notifications via SMTP) ────────────────────────────────
# All current email features (worklog reports, invites, revoke, reminders) and
# any future feature share these. Email is enabled automatically when the four
# required vars (FROM/HOST/USERNAME/PASSWORD) are all set; if any is blank the
# app skips sending and logs a warning. A devops/engineering person sets these
# per environment.
#
# Local dev: these already point at the in-stack Mailpit sink (SMTP :1025, UI
# http://localhost:8025). See docs/GETTINGSTARTED.md.
EMAIL_FROM=khoji@scrumupdate.local
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_USERNAME=mailpit
EMAIL_PASSWORD=mailpit
EMAIL_STARTTLS=false

# ── KBS basic auth (APP authority — machine-to-machine) ────────────────────
# Credentials for KBS's APP authority (@AuthorizationApplicationLevelAPIs).
# Used by inter-service callers (KGS ↔ KBS, KSS ↔ KBS) and E2E test
# automation (cloud-automation).
# The values below are the old hardcoded dev defaults kept for local develop-
# ment; deployments must set non-default values — KBS refuses to start outside
# the dev profile when either value is blank (fail-closed). Leaving them blank
# disables basic auth entirely (all APP endpoints return 401).
# Full consumer list: docs/SECURITY.md → "APP basic auth".
KHOJI_BASICAUTHUSERNAME=khoji@scrumupdate.local
KHOJI_BASICAUTHUSERPASSWORD=khoji

# ── reCAPTCHA (login/signup) ────────────────────────────────────────────────
# Google reCAPTCHA v2 key pair. Set BOTH values to enable captcha; leave both
# empty to skip it cleanly (no script load, no console errors, login works).
#  - RECAPTCHA_SECRET: secret key -> KBS verification (Google siteverify)
#  - NG_CAPTCHA_KEY:   site key (its public half) -> Angular login widget
# Create a v2 "I'm not a robot" pair at https://www.google.com/recaptcha/admin
# and add every served domain (local: localhost:4241). reCAPTCHA keys are
# domain-bound; a key from another domain shows "Invalid site key".
RECAPTCHA_SECRET=
NG_CAPTCHA_KEY=
NG_DISABLE_CAPTCHA=false

# ── Teams Bot (KGS) ──────────────────────────────────────────────────────────
# Optional — KGS starts without these; bot features (proactive messaging, OAuth)
# are degraded when missing.
TEAMS_APP_ID=
MS_BOT_CLIENT_ID=
MS_BOT_CLIENT_SECRET=

# ── Microsoft OAuth (Teams/calendar integration) ────────────────────────────
# Single source of truth for the MS app registration. Consumed directly by KBS
# via Spring relaxed binding (INTEGRATIONS_MS_OAUTH_CLIENT_ID →
# integrations.ms.oauth.client.id) and by Angular via compose.
# Token URL & scopes have code/
# compose defaults — kept out of here. The Calendar UI vanishes automatically
# when these vars are unset.
# NOTE: sensitive — will be replaced with a secret store or placeholder in a
# follow-up (see AGENTS.md: .env is never committed).
INTEGRATIONS_MS_OAUTH_CLIENT_ID=
INTEGRATIONS_MS_OAUTH_CLIENT_SECRET=
INTEGRATIONS_MS_REDIRECT_URI=

# ── Tenant token keystore (KBS) ─────────────────────────────────────────────
# External JCEKS used to encrypt jwt_source_token and jwt_source_refresh_token.
# Do not commit the file or these passwords. Generate new key material; the
# previously committed keystore is compromised and must not be reused.
# Compose mounts the host directory ./secrets at /run/secrets, not the keystore
# file. A missing file bind would become a directory. Inside the container,
# KEY_STORE_PATH is /run/secrets/khoji-keystore.jck. Place the generated file
# at secrets/khoji-keystore.jck on the host. KBS fails startup when either
# password is blank. See docs/LOCAL_DOCKER.md.
KEY_STORE_PASSWORD=
KEY_PASSWORD=
# Set KEY_STORE_MIGRATE=true only for the one run that re-encrypts stored
# tenant tokens. OLD_KEY_STORE_PATH is the path inside the container, under
# /run/secrets/. Put the old file in the host secrets/ directory. Do not set a
# host path such as C:\...; Compose passes this value into the container.
# Do not commit that file or these passwords.
KEY_STORE_MIGRATE=
OLD_KEY_STORE_PATH=
OLD_KEY_STORE_PASSWORD=
OLD_KEY_PASSWORD=

# ── Angular web UI (env.template.js substitution) ───────────────────────────
#
# IMPORTANT: These two ports are NOT the same service.
#
#   NG_SERVER_PORT (4243) — the KBS Java backend.  Angular's API_URL is built
#     from this value so that all XHR/fetch calls go directly to KBS inside the
#     Docker network (no Express proxy needed for KBS endpoints).
#
#   NG_APP_PORT   (4241) — the Express server that serves the Angular SPA and
#     owns the public-facing port.  Used only for LOGIN_PAGE_URL so the OAuth
#     redirect_uri includes the correct port (http://localhost:4241/login).
#
# In production these are NOT set — Traefik routes by hostname instead.
# ───────────────────────────────────────────────────────────────────────────
NG_SERVER_NAME=localhost
NG_SERVER_PORT=4243
NG_APP_PORT=4241
NG_JIRA_ISSUE_COLLECTOR_LINK=
NG_SUPPORT_EMAIL=
NG_REQUEST_PANEL_VISIBILITY=
NG_TRACKING_PROVIDER=
NG_TRACKING_API_TOKEN=
NG_TRACKING_API_HOST=
NG_TRACKING_AUTO_EVENTS=
NG_TRACKING_NAVIGATION_EVENTS=
NG_TRACKING_USER_ACTION_EVENTS=
NG_TRACKING_APPLICATION_STATUS_EVENTS=
NG_JIRA_SCOPES=read:me read:jira-user offline_access
# reCAPTCHA site key (see the reCAPTCHA section above): NG_CAPTCHA_KEY is the
# public half of the key pair served in the login widget; RECAPTCHA_SECRET is
# the secret half used by KBS. Set both or neither.
NG_MS_OAUTH_TOKEN_URL=
NG_MS_OAUTH_REQUESTED_SCOPES=
NG_UNLEASH=true
NG_UNLEASH_URL=http://localhost:4242
NG_UNLEASH_PROJECT=default
NG_UNLEASH_ENVIRONMENT=development
NG_UNLEASH_ADMIN_URL=http://unleash:4242
#
# NOTE: tokens below are placeholders. Generate your own, e.g.
#   $hex = openssl rand -hex 32    then use  default:development.<hex>
# INIT_* tokens are seeded on the Unleash container only on the FIRST boot of a
# fresh volume (see devops/postgres-init + docker-compose unleash service).
#
# Admin UI login (used by the one-shot unleash-init seeding job; NOT used by
# any long-running application container).
#UNLEASH_ADMIN_USERNAME=admin
UNLEASH_ADMIN_PASSWORD=unleash4all
# Seeded on the unleash container on first boot
UNLEASH_BACKEND_API_TOKEN=default:development.1234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef
UNLEASH_FRONTEND_API_TOKEN=default:development.fedcba0987654321fedcba0987654321fedcba0987654321fedcba0987654321
# Express admin sync (minted by scripts/bootstrap-unleash-token.* after first boot)
UNLEASH_ADMIN_PAT=user:78d7954d87bc59ec787143ba9d6f4e7987dbed9786dcce6a6d6f887f
